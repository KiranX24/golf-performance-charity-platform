# =====================================================================
# Digital Heroes backend — environment variables
# Copy this file to a real .env (or configure equivalently in your
# STS Run Configuration / shell / hosting provider's env settings).
# NEVER commit a real .env file. It is already covered by .gitignore.
# =====================================================================

# ---------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# Find these in: Supabase project → Settings → Database → Connection Info
# ---------------------------------------------------------------------
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# ---------------------------------------------------------------------
# JWT
# Generate a strong random secret, e.g.:
#   openssl rand -base64 64
# Must be long enough for HS256/HS512 — do not use a short phrase.
# ---------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_base64_secret
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---------------------------------------------------------------------
# Stripe (configured in Phase: Subscriptions)
# Found in: Stripe Dashboard → Developers → API keys / Webhooks
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Supabase Storage (configured in Phase: Winner Verification)
# Found in: Supabase project → Settings → API
# ---------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=winner-proofs

# ---------------------------------------------------------------------
# Application URLs
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
SERVER_PORT=8080
